PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/hershield
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Default simulates alerts WITHOUT contacting the provider. Configure ALL IDs before switching.
ALERTS_DRY_RUN=true
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_WA_PHONE_NUMBER_ID=
# DLT message IDs from Fast2SMS; five template variables as documented in README.
SMS_MESSAGE_ID_STAGE_2=
SMS_MESSAGE_ID_STAGE_3=
SMS_MESSAGE_ID_STAGE_4=
SMS_MESSAGE_ID_STAGE_5=
WA_MESSAGE_ID_STAGE_4=
WA_MESSAGE_ID_STAGE_5=
